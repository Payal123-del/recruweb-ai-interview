# Environment Configuration for Ardhnarishwar AI Robotics Interview Platform

# Application
ENVIRONMENT=development
PROJECT_NAME="Ardhnarishwar AI Robotics Interview Platform"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=ardhnarishwar_super_secret_jwt_key_change_in_production_2026!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ardhnarishwar_db
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage (S3 / MinIO / R2 abstraction)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=ardhnarishwar-recordings
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_LOCAL_DIR=./storage_data

# Internal AI Evaluation Version
EVALUATION_ENGINE_VERSION=internal-v1

# Super Admin Default Seed (Dev Only)
SUPER_ADMIN_EMAIL=admin@ardhnarishwar.ai
SUPER_ADMIN_PASSWORD=AdminSecurePassword123!
